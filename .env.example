# =============================================================================
# EthosFinancial 1.0 — Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env e ajuste os valores antes de subir o docker-compose
# =============================================================================

# ---------- Geral ----------
NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_USER=ethos
POSTGRES_PASSWORD=ethos_secret
POSTGRES_DB=ethos_financial
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ethos:ethos_secret@localhost:5432/ethos_financial

# ---------- Redis (BullMQ) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- API (Backend) ----------
API_PORT=3000
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Web (Frontend) ----------
WEB_PORT=4200

# ---------- Evolution API v2 (WhatsApp) ----------
EVOLUTION_API_PORT=8080
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-key
EVOLUTION_DB=evolution_api
EVOLUTION_INSTANCE_NAME=ethos-cobranca

# ---------- Inteligência Artificial (mensagens de cobrança) ----------
# AI_PROVIDER: "groq" (nuvem) ou "ollama" (local)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
OLLAMA_PORT=11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------- Regras de Negócio (Configurações padrão) ----------
MIN_PARCELAS_VENCIDAS=3
DIAS_ATRASO_MINIMO=0
PASTA_SAIDA_DOCUMENTOS=./output/relatorios
MODELO_DOCX_PROTESTO=./templates/modelo-protesto.docx

# ---------- Documento de Protesto ----------
INSTITUICAO_NOME=INSTITUTO ETHOS EDUCAÇÃO DIGITAL LTDA
INSTITUICAO_CNPJ=39.279.631/0001-27
# Usados só na criação inicial da linha de Configuracao (singleton) — depois
# disso, editar via módulo de configurações (Sprint 5) e não mais por env.
MULTA_PERCENTUAL=2
JUROS_DIARIO_PERCENTUAL=0.033
# true = conta os dias de atraso até o dia da geração do relatório (inclusive)
# false = conta só até o dia anterior à geração
JUROS_CONTAR_DIA_GERACAO=true

# ---------- Ferramentas opcionais ----------
ADMINER_PORT=8081
