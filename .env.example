# =============================================================================
# EthosFinancial 1.0 — Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env e ajuste os valores (dev: docker-compose.yml;
# produção: ver DEPLOY.md — Rotas A/B/C)
# =============================================================================

# ---------- Geral ----------
NODE_ENV=development

# ---------- PostgreSQL ----------
POSTGRES_USER=ethos
POSTGRES_PASSWORD=ethos_secret
POSTGRES_DB=ethos_financial
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ethos:ethos_secret@localhost:5432/ethos_financial

# ---------- Redis (BullMQ) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- API (Backend) ----------
API_PORT=3000
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Autenticação (Sprint 7) ----------
# Usados só para criar o primeiro usuário ADMINISTRADOR, se ainda não existir
# nenhum (apps/api/src/bootstrap/seed-admin.ts) — troque a senha pela tela de
# gestão de usuários depois do primeiro login.
ADMIN_EMAIL=admin@ethosfinancial.local
ADMIN_PASSWORD=admin123

# ---------- Web (Frontend) ----------
WEB_PORT=4200

# ---------- Regras de Negócio (Configurações padrão) ----------
DIAS_ATRASO_MINIMO=90
PASTA_SAIDA_DOCUMENTOS=./output/relatorios
MODELO_DOCX_PROTESTO=./templates/modelo-protesto.docx

# ---------- Documento de Protesto ----------
INSTITUICAO_NOME=INSTITUTO ETHOS EDUCAÇÃO DIGITAL LTDA
INSTITUICAO_CNPJ=39.279.631/0001-27
# Usados só na criação inicial da linha de Configuracao (singleton) — depois
# disso, editar via módulo de configurações (Sprint 5) e não mais por env.
MULTA_PERCENTUAL=2
JUROS_DIARIO_PERCENTUAL=0.033
# true = conta os dias de atraso até o dia da geração do relatório (inclusive)
# false = conta só até o dia anterior à geração
JUROS_CONTAR_DIA_GERACAO=true

# ---------- Ferramentas opcionais ----------
ADMINER_PORT=8081
