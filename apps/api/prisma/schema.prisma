// =============================================================================
// EthosFinancial 1.0 — Schema Prisma
// Reflete o modelo de dados descrito na especificação (seção 20)
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" cobre o dev local (Windows); linux-musl-openssl-3.0.x cobre os
  // containers Docker (node:20-alpine vem com OpenSSL 3.x, não 1.1).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ADMINISTRADOR: acesso irrestrito a todas as funções.
// FINANCEIRO: cursos, alunos, matrículas, importação e geração de documentos
// em relatórios (inclui o módulo `financeiro`/Parcela — decisão registrada em
// docs/PENDENCIAS.md, já que o perfil leva esse nome).
// USUARIO: alunos, matrículas e geração de documentos em relatórios.
enum PerfilUsuario {
  ADMINISTRADOR
  FINANCEIRO
  USUARIO
}

enum StatusParcela {
  EM_ABERTO
  PAGO
  CANCELADO
  PROTESTADO
  RENEGOCIADO
}

enum FrequenciaImportacao {
  MANUAL
  SEMANAL
  MENSAL
}

enum TabelaDestinoImportacao {
  ALUNO
  MATRICULA
  PARCELA
}

enum AcaoColunaAusente {
  VALOR_PADRAO
  NAO_IMPORTAR
}

model Usuario {
  id        String        @id @default(uuid())
  nome      String
  email     String        @unique
  senhaHash String
  perfil    PerfilUsuario @default(USUARIO)
  ativo     Boolean       @default(true)
  criadoEm  DateTime      @default(now())

  importacoes             Importacao[]
  auditorias              Auditoria[]
  historicosCobranca      HistoricoCobranca[]
  relatoriosInadimplencia RelatorioInadimplencia[]

  @@map("usuarios")
}

model Aluno {
  id         String   @id @default(uuid())
  cpf        String   @unique
  nome       String
  tipoPessoa String?  @map("tipo_pessoa")
  email      String?
  telefone1  String?  @map("telefone_1")
  telefone2  String?  @map("telefone_2")
  cep        String?
  endereco   String?
  numero     String?
  complemento String?
  bairro     String?
  cidade     String?
  estado     String?
  criadoEm   DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  matriculas Matricula[]

  @@map("alunos")
}

model Curso {
  id          String   @id @default(uuid())
  codigo      String   @unique
  nome        String
  situacao    Boolean  @default(true)
  observacoes String?

  matriculas              Matricula[]
  relatoriosInadimplencia RelatorioInadimplencia[]

  @@map("cursos")
}

model Matricula {
  id               String    @id @default(uuid())
  alunoId          String    @map("aluno_id")
  cursoId          String    @map("curso_id")
  numeroMatricula  String?   @map("numero_matricula")
  dataMatricula    DateTime? @map("data_matricula")
  contratoAssinado Boolean   @default(false) @map("contrato_assinado")
  situacao         String    @default("ATIVA")
  observacoes      String?

  aluno Aluno @relation(fields: [alunoId], references: [id])
  curso Curso @relation(fields: [cursoId], references: [id])

  parcelas           Parcela[]
  tags               MatriculaTag[]
  historicoCobranca  HistoricoCobranca[]
  observacoesCobranca ObservacaoCobranca[]
  situacaoCobrancaId String? @map("situacao_cobranca_id")
  situacaoCobranca   SituacaoCobranca? @relation(fields: [situacaoCobrancaId], references: [id])

  @@unique([alunoId, cursoId, numeroMatricula])
  @@map("matriculas")
}

model Parcela {
  id            String        @id @default(uuid())
  matriculaId   String        @map("matricula_id")
  codTitulo     String        @map("cod_titulo")
  parcela       String
  vencimento    DateTime
  valor         Decimal       @db.Decimal(12, 2)
  tipoTitulo    String?       @map("tipo_titulo")
  status        StatusParcela @default(EM_ABERTO)
  dataPagamento DateTime?     @map("data_pagamento")
  valorPago     Decimal?      @db.Decimal(12, 2) @map("valor_pago")
  observacoes   String?
  /// Valor com juros e multa já calculado pelo sistema de origem da planilha
  /// (coluna TITULO_VALOR_JUROS_E_MULTA) — só para referência/conferência.
  /// NÃO substitui o cálculo próprio do sistema (Configuracao.multaPercentual/
  /// jurosDiarioPercentual), decisão do usuário registrada em
  /// docs/PENDENCIAS.md (2026-07-09).
  valorOrigemComJurosEMulta Decimal? @db.Decimal(12, 2) @map("valor_origem_com_juros_e_multa")

  matricula Matricula @relation(fields: [matriculaId], references: [id])

  @@unique([matriculaId, codTitulo])
  @@map("parcelas")
}

model Importacao {
  id                  String   @id @default(uuid())
  usuarioId           String   @map("usuario_id")
  arquivo             String
  data                DateTime @default(now())
  totalRegistros      Int      @default(0) @map("total_registros")
  novosAlunos         Int      @default(0) @map("novos_alunos")
  alunosAtualizados   Int      @default(0) @map("alunos_atualizados")
  parcelasNovas       Int      @default(0) @map("parcelas_novas")
  parcelasAtualizadas Int      @default(0) @map("parcelas_atualizadas")
  erros               Json?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("importacoes")
}

model Configuracao {
  id                     String  @id @default(uuid())
  /// Único critério de elegibilidade para o relatório de inadimplência —
  /// "parcelas mínimas vencidas" foi removido (decisão do usuário, 2026-07-06):
  /// dias de atraso já é suficiente para detectar parcela atrasada ou não.
  diasAtraso             Int     @default(90) @map("dias_atraso")
  pastaSaidaDocumentos   String  @map("pasta_saida_documentos")
  modeloDocx             String  @map("modelo_docx")
  padraoNomeArquivo      String  @default("{NOME}_{CPF}_{CURSO}.docx") @map("padrao_nome_arquivo")
  frequenciaImportacao   FrequenciaImportacao @default(MANUAL) @map("frequencia_importacao")

  // Multa/juros do relatório de inadimplência e documento de protesto
  // (seção 15/23 do PRD; fórmula confirmada pelo usuário em 2026-07-03).
  /// Percentual flat de multa sobre o valor bruto da parcela (ex.: 2 = 2%).
  multaPercentual        Decimal @default(2) @db.Decimal(5, 2) @map("multa_percentual")
  /// Percentual de juros por dia de atraso (ex.: 0.033 = 0.033% ao dia).
  jurosDiarioPercentual  Decimal @default(0.033) @db.Decimal(6, 3) @map("juros_diario_percentual")
  /// true: conta os dias de atraso até o dia da geração do relatório (inclusive).
  /// false: conta só até o dia anterior à geração.
  jurosContarDiaGeracao  Boolean @default(true) @map("juros_contar_dia_geracao")

  @@map("configuracoes")
}

// Mapeamento configurável coluna da planilha → tabela/campo de destino
// (tela de Configurações). Os campos "estruturais" da importação (CNPJ_CPF,
// NOME, COD_TITULO, PARCELA, DT_VENCIMENTO, VALOR, CURSO) não são
// configuráveis aqui porque a lógica de localizar/criar Aluno, Curso,
// Matrícula e Parcela depende deles — só os campos complementares (contato,
// endereço, dados da matrícula/parcela) passam por este mapeamento.
model MapeamentoImportacao {
  id             String                   @id @default(uuid())
  colunaPlanilha String                   @unique @map("coluna_planilha")
  tabelaDestino  TabelaDestinoImportacao  @map("tabela_destino")
  campoDestino   String                   @map("campo_destino")
  acaoAusente    AcaoColunaAusente        @default(NAO_IMPORTAR) @map("acao_ausente")
  valorPadrao    String?                  @map("valor_padrao")
  ativo          Boolean                  @default(true)
  criadoEm       DateTime                 @default(now()) @map("criado_em")
  atualizadoEm   DateTime                 @updatedAt @map("atualizado_em")

  @@unique([tabelaDestino, campoDestino])
  @@map("mapeamentos_importacao")
}

// Histórico de geração do Relatório de Inadimplência (PRD seções 15 e 21).
// Os itens elegíveis (aluno/matrícula/valores/documento gerado) ficam em JSON
// em vez de uma tabela filha — mesmo padrão já usado em Importacao.erros.
model RelatorioInadimplencia {
  id                     String   @id @default(uuid())
  usuarioId              String   @map("usuario_id")
  data                   DateTime @default(now())
  diasAtraso             Int?     @map("dias_atraso")
  valorMinimo            Decimal? @db.Decimal(12, 2) @map("valor_minimo")
  cursoId                String?  @map("curso_id")
  /// Decisão do usuário, 2026-07-07: por padrão o documento de protesto só
  /// inclui parcelas vencidas há mais de `diasAtraso` dias (Configuracao);
  /// quando true, inclui também as parcelas só "vencidas" (menos que o
  /// mínimo) da mesma matrícula, no mesmo documento.
  incluirParcelasVencidasRecentes Boolean @default(false) @map("incluir_parcelas_vencidas_recentes")
  totalElegiveis         Int      @default(0) @map("total_elegiveis")
  totalDocumentosGerados Int      @default(0) @map("total_documentos_gerados")
  itens                  Json?
  erros                  Json?

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  curso   Curso?  @relation(fields: [cursoId], references: [id])

  @@map("relatorios_inadimplencia")
}

model SituacaoCobranca {
  id                       String   @id @default(uuid())
  nome                     String   @unique
  cor                      String
  ordem                    Int      @default(0)
  ativa                    Boolean  @default(true)
  descricao                String?
  participaNovosRelatorios Boolean  @default(true) @map("participa_novos_relatorios")

  matriculas Matricula[]

  @@map("situacoes_cobranca")
}

model Tag {
  id   String @id @default(uuid())
  nome String @unique

  matriculas MatriculaTag[]

  @@map("tags")
}

model MatriculaTag {
  matriculaId String @map("matricula_id")
  tagId       String @map("tag_id")

  matricula Matricula @relation(fields: [matriculaId], references: [id])
  tag       Tag       @relation(fields: [tagId], references: [id])

  @@id([matriculaId, tagId])
  @@map("matricula_tags")
}

model HistoricoCobranca {
  id          String   @id @default(uuid())
  matriculaId String   @map("matricula_id")
  usuarioId   String   @map("usuario_id")
  data        DateTime @default(now())
  acao        String

  matricula Matricula @relation(fields: [matriculaId], references: [id])
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@map("historico_cobranca")
}

model ObservacaoCobranca {
  id          String   @id @default(uuid())
  matriculaId String   @map("matricula_id")
  data        DateTime @default(now())
  texto       String

  matricula Matricula @relation(fields: [matriculaId], references: [id])

  @@map("observacoes_cobranca")
}

model Auditoria {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  entidade   String
  entidadeId String   @map("entidade_id")
  acao       String
  detalhes   Json?
  data       DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("auditoria")
}
